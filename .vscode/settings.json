    "python.analysis.extraPaths": [
        "./src"
    ],
    "yaml.customTags": [
        "!Ref scalar",
        "!Sub scalar",
        "!Sub sequence",
        "!GetAtt scalar",
        "!GetAtt sequence",
        "!If sequence",
        "!Not sequence",
        "!Equals sequence",
        "!And sequence",
        "!Or sequence",
        "!Join sequence",
